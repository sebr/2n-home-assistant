#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Install uv if not already present
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
fi

# Install dependencies (runtime + dev) into a managed virtualenv
uv sync
